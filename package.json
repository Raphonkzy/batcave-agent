{
  "name": "batcave-agent",
  "version": "2.0.0-manor",
  "description": "3D read-only dashboard for Hermes & OpenCode (Batcave Tactical Manor theme)",
  "author": "Raphonkzy",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Raphonkzy/batcave-agent.git"
  },
  "homepage": "https://github.com/Raphonkzy/batcave-agent#readme",
  "bin": {
    "batcave": "bin/batcave.js"
  },
  "files": [
    "bin",
    "build/server",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.build.json",
    "start": "node bin/batcave.js",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@react-three/fiber": "^9.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "batcave",
    "hermes-agent",
    "opencode",
    "mission-control",
    "tactical-manor",
    "dashboard",
    "ai-agents"
  ]
}
